{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magic Mirror",
  "version": "0.2.0",
  "identifier": "dev.finallee.magicmirror",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Magic Mirror",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBOUFERDQ3RkRGQUZFOUEKUldTYS92cjlSOTJhV2tIUWJxVVJYNGdxUmpmOG1ScXVIcThqVytlczF6WUxhUlUwamN3cEpNbWIK",
      "endpoints": [
        "https://github.com/final-lee/magic-mirror/releases/latest/download/latest.json"
      ]
    }
  }
}
